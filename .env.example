# Copie este arquivo para .env e coloque a sua chave do Google AI Studio.
GEMINI_API_KEY=
# Modelo usado nas chamadas. Rode "python manage.py listar_modelos" para ver os disponíveis.
GEMINI_MODEL=gemini-2.5-pro
GEMINI_TEMPERATURA=0.4

# Provedor da IA: gemini ou openai.
IA_PROVEDOR=openai
OPENAI_API_KEY=
# Modelo que escreve e modelo que confere. Rode "python manage.py listar_modelos" para ver os disponíveis.
OPENAI_MODEL=gpt-6-sol
OPENAI_MODEL_VERIFICACAO=gpt-6-luna
# Modo de pensar: none, low, medium, high, xhigh ou max. Vazio desliga (para modelos sem raciocínio).
OPENAI_RACIOCINIO=medium
OPENAI_RACIOCINIO_VERIFICACAO=low
# Segundos de espera por chamada à IA.
IA_TIMEOUT=300
# Modelos que a psicóloga escolhe na conversa (modelo=rótulo|...). O primeiro é o padrão da tela.
IA_MODELOS=gpt-6-sol=Melhor qualidade|gpt-6-luna=Mais rápido e barato|gpt-5.4-mini=Econômico

# Django. Em produção: DJANGO_DEBUG=0, uma chave longa e aleatória e o domínio do site.
DJANGO_SECRET_KEY=
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Em produção, o domínio do Render com https:// (ex: https://assistente-anamnese.onrender.com).
DJANGO_CSRF_TRUSTED_ORIGINS=

# Banco de dados. Vazio = SQLite local. Em produção, cole a connection string do Neon (postgres://...).
DATABASE_URL=

# Administrador criado por "python manage.py garantir_admin". Defina no .env e no painel do Render.
ADMIN_USUARIO=
ADMIN_SENHA=
